{
  "name": "kr-smart-rbi",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "KR Smart RBI — 합성 데이터 기반 위험도 기반 검사 MVP (bkit 구현 대상)",
  "scripts": {
    "dev": "next dev -H localhost -p 3000",
    "build": "next build",
    "start": "next start -H localhost -p 3000",
    "start:e2e": "next build && APP_TEST_MODE=1 DATABASE_PATH=data/e2e.db next start -H localhost -p 3000",
    "db:seed": "node --env-file-if-exists=.env.local scripts/db-seed.mjs",
    "seed:generate": "node scripts/generate-synthetic-data.mjs",
    "typecheck": "tsc --noEmit",
    "test:unit": "node --test tests/unit/*.test.mjs",
    "test:e2e": "playwright test",
    "test:e2e:list": "playwright test --list",
    "prd:check": "node scripts/check-prd.mjs",
    "prd:derive": "node scripts/derive-feature-prds.mjs",
    "prd:html": "node scripts/render-prd-html.mjs docs/PRD.md docs/PRD.html",
    "prd:build": "npm run prd:check && npm run prd:derive && npm run prd:html"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.10.2",
    "@playwright/test": "1.56.1",
    "@types/better-sqlite3": "^9.6.0",
    "@types/node": "^22.20.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "marked": "15.0.12",
    "typescript": "^5.9.3"
  },
  "dependencies": {
    "bcryptjs": "^3.0.3",
    "better-sqlite3": "^13.0.3",
    "next": "^15.5.27",
    "pretendard": "^1.3.9",
    "react": "^19.1.1",
    "react-dom": "^19.1.1",
    "server-only": "^0.0.1"
  },
  "overrides": {
    "postcss": "^8.5.30"
  }
}
