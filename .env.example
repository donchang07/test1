# 이름만 적는다. 값은 커밋·채팅·문서에 쓰지 않는다. 자세한 규칙: docs/PRD.md 11.3
# 이 파일을 .env.local 로 복사해 값을 채운다(.env.local은 gitignore, Next.js가 자동으로 읽음).

# 시드 계정 비밀번호(필수). db:seed, 테스트 초기화, E2E 로그인에 쓴다
SEED_INSPECTOR_PASSWORD=
SEED_ADMIN_PASSWORD=

# SQLite 파일 경로. 비우면 data/app.db (E2E는 npm run start:e2e가 data/e2e.db로 지정)
DATABASE_PATH=

# 테스트 API. npm run start:e2e만 1로 설정한다. 여기서는 비워 둔다
APP_TEST_MODE=

# E2E 대상. 비우면 http://localhost:3000
E2E_BASE_URL=
