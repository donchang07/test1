# 이름만 적는다. 값은 커밋·채팅·문서에 쓰지 않는다. 자세한 규칙: docs/PRD.md 11.3
# 로컬은 `vercel env pull .env.local` 로 받는 것을 기본으로 한다.

# Supabase (Vercel 통합이 자동 등록. 로컬·Preview·CI는 테스트용 프로젝트 값)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# 서버 전용 비밀 키. NEXT_PUBLIC_ 접두사 금지
SUPABASE_SECRET_KEY=

# 시드 계정 비밀번호 (Preview·로컬·CI만. Production에는 등록하지 않음)
SEED_INSPECTOR_PASSWORD=
SEED_ADMIN_PASSWORD=

# 테스트 API 활성화 (Production에는 절대 등록하지 않음)
APP_TEST_MODE=1

# E2E 대상. 비우면 로컬 npm run start:e2e
E2E_BASE_URL=
# Vercel Preview 대상 E2E일 때만 (Deployment Protection > Protection Bypass for Automation)
VERCEL_AUTOMATION_BYPASS_SECRET=
