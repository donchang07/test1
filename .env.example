# 이름만 적는다. 값은 커밋·채팅·문서에 쓰지 않는다. 자세한 규칙: docs/PRD.md 11.3
# Supabase 프로젝트는 운영용 1개다. 로컬은 `vercel env pull .env.local` 로 받는 것을 기본으로 한다.

# Supabase (Vercel 통합이 자동 등록하는 이름. next.config.ts가 NEXT_PUBLIC_*로 브라우저에 넘긴다)
SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=
# 서버 전용 비밀 키(sb_secret_…). next.config env나 NEXT_PUBLIC_ 이름으로 노출 금지
SUPABASE_SECRET_KEY=

# 시드 계정 비밀번호 (로컬·CI·Claude 세션만. Vercel에는 등록하지 않음)
SEED_INSPECTOR_PASSWORD=
SEED_ADMIN_PASSWORD=

# E2E 전용. Vercel에는 절대 등록하지 않음
# APP_TEST_MODE=1 은 npm run start:e2e 가 설정한다
# 운영 DB 초기화 동의
E2E_ALLOW_SHARED_DB=
# 비우면 로컬 npm run start:e2e
E2E_BASE_URL=
